# Copy API settings to hogulink-api/.env; dev defaults work without this file.
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_MODE=demo
PAYMENT_PROVIDER=demo
# Keep enabled only for local demonstrations. Set 0 for shared test environments.
DEMO_ACCESS_ENABLED=1
# Email delivery: disabled | resend | webhook. No emails leave this machine by default.
EMAIL_PROVIDER=disabled
# PUBLIC_WEB_URL=http://localhost:3000
# EMAIL_FROM=HoguLink <notice@your-verified-domain.example>
# RESEND_API_KEY=configure-locally-do-not-commit
# NOTIFICATION_WEBHOOK_URL=https://your-notification-gateway.example/send
# NOTIFICATION_WEBHOOK_SECRET=at-least-32-random-characters
# Required in staging: SOS, safety and overdue alerts are sent here.
# OPS_NOTIFICATION_EMAIL=your-on-call-mailbox
# DATA_ENCRYPTION_KEY=32-random-bytes-encoded-as-base64
# EVIDENCE_DIRECTORY=data/private-evidence
# RUN_BACKGROUND_JOBS=1
# Full access-controlled deployment and *_FILE secrets: docs/NONPAYMENT_READINESS.md
# Production startup is intentionally disabled until real identity/PSP adapters exist.
# PostgreSQL can be exercised locally by setting DATABASE_URL.
# DATABASE_URL=postgresql://hogulink:local_only@localhost:5432/hogulink
# SQLITE_PATH=data/hogulink.sqlite
# CHECKOUT_HOLD_TTL_SECONDS=600
# NOMINATION_FEE_JPY=500
# STANDARD_FEE_BPS=1000
# ANNUAL_FEE_BPS=500
